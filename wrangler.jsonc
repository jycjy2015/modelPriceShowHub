{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "model-price-admin",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "modeladmin.tokenixs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "apps/admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "model-price-db-production",
      "database_id": "2a99b6de-5227-4f79-befa-f00436d173c4",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "model-price-pdfs-production"
    }
  ]
}
